# ──────────────────────────────────────────────────────────────────────────────
# Real-browser E2E configuration  →  copy to `.env.e2e` and fill in.
#
# `.env.e2e` is gitignored. It is loaded (and overrides .env.local) by
# playwright.config.ts. Leave the organizer creds blank to run only the public
# (no-auth) lane; fill them in to unlock the authenticated organizer specs.
# ──────────────────────────────────────────────────────────────────────────────

# Clerk keys — use a DEVELOPMENT instance (test mode), never production.
# These usually already exist in .env.local; repeat here only to override.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# A Clerk test user with:
#   • password sign-in enabled
#   • publicMetadata.role = "tournament-organizer"
#   • publicMetadata.onboardingComplete = true
E2E_CLERK_ORGANIZER_EMAIL=
E2E_CLERK_ORGANIZER_PASSWORD=

# Optional: point the run at a different base URL (defaults to localhost:3000).
# BASE_URL=http://localhost:3000
